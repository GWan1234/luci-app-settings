msgid ""
msgstr ""
"Project-Id-Version: luci-app-settings\n"
"Language: zh_Hans\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "%s — %d bytes, last modified: %s"
msgstr "%s — %d 字节,最后修改时间:%s"

msgid "%s — file does not exist yet, it will be created when saving."
msgstr "%s — 文件尚不存在,保存时将自动创建。"

msgid "Absolute path under /etc/, e.g. /etc/sysctl.conf."
msgstr "仅限 /etc/ 下的绝对路径,例如 /etc/sysctl.conf。"

msgid "Add"
msgstr "添加"

msgid "Add custom file"
msgstr "添加自定义文件"

msgid "Add custom file…"
msgstr "添加自定义文件…"

msgid "Apply action: restart service \"%s\"."
msgstr "应用方式:重启服务“%s”。"

msgid "Apply action: run reload_config (this only reloads services for files under /etc/config)."
msgstr "应用方式:执行 reload_config(仅会重载 /etc/config 下文件对应的服务)。"

msgid "Cancel"
msgstr "取消"

msgid "Changed configuration files were applied via reload_config."
msgstr "已通过 reload_config 重新加载发生变化的配置。"

msgid "Command failed with exit code %d: %s"
msgstr "命令执行失败,退出码 %d:%s"

msgid "Configuration Files"
msgstr "高级设置"

msgid "Contents of %s have been reloaded from disk."
msgstr "已从磁盘重新载入 %s 的内容。"

msgid "Contents of %s have been saved and applied."
msgstr "%s 的内容已保存并应用。"

msgid "Contents of %s have been saved."
msgstr "%s 的内容已保存。"

msgid "DHCP / DNS"
msgstr "DHCP / DNS"

msgid "Detected init.d script with the same name: \"%s\"."
msgstr "检测到同名 init.d 脚本:“%s”。"

msgid "Directly edit the raw contents of common UCI configuration files under /etc/config and apply the changes. Custom files can be added to the list with the button below."
msgstr "直接编辑 /etc/config 下常用 UCI 配置文件的原始内容并使更改生效。也可以通过下方按钮将自定义文件加入列表。"

msgid "Failed to update the custom file list: %s"
msgstr "更新自定义文件列表失败:%s"

msgid "File path"
msgstr "文件路径"

msgid "File was saved, but applying the changes failed: %s"
msgstr "文件已保存,但应用更改失败:%s"

msgid "Firewall"
msgstr "防火墙"

msgid "Init script to restart on apply (optional)"
msgstr "应用时重启的 init 脚本(可选)"

msgid "Invalid file path."
msgstr "无效的文件路径。"

msgid "Invalid service name."
msgstr "无效的服务名称。"

msgid "JSON syntax check failed: %s"
msgstr "JSON 语法检查失败:%s"

msgid "Matched"
msgstr "已匹配"

msgid "Network"
msgstr "网络"

msgid "Please enter an absolute file path below /etc/."
msgstr "请输入 /etc/ 下的绝对文件路径。"

msgid "Remove from list"
msgstr "从列表中移除"

msgid "Reset"
msgstr "复位"

msgid "Save"
msgstr "保存"

msgid "Save & Apply"
msgstr "保存并应用"

msgid "Service \"%s\" has been restarted."
msgstr "服务“%s”已重启。"

msgid "System"
msgstr "系统"

msgid "This file is already in the list."
msgstr "该文件已在列表中。"

msgid "UCI syntax check failed: %s"
msgstr "UCI 语法检查失败:%s"

msgid "Unable to save %s: %s"
msgstr "无法保存 %s:%s"

msgid "init.d service name; leave empty to run reload_config."
msgstr "init.d 服务名,留空则执行 reload_config。"
